# Groq API (for document extraction — LLM + vision)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SerpAPI (optional — for live Google Images search of network hospitals)
